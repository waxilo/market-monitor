{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarketMonitor",
  "version": "0.1.5",
  "identifier": "com.waxilo.marketmonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Market Monitor",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "MarketMonitor Self-Signed",
      "hardenedRuntime": false
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/waxilo/market-monitor/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRjY1RDJFMTkwMzZCMjIKUldRaWF3TVpMbDMyQ3p0NVU3STRBVDBEVVFQVmdaR0RyU3BFZ1AzNkZqNnJNK3FlSnI5Y3p0UjgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
