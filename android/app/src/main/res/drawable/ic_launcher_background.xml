<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的**背景层**：深色圆角方底的渐变（与桌面端母版同一组色标）。
     画满 108×108 —— 遮罩会裁掉外圈，超出的部分不会露出来，但各厂商的视差效果需要它。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="3.4" android:startY="3.4"
                android:endX="35.8" android:endY="104.6">
                <item android:offset="0" android:color="#262B3A" />
                <item android:offset="1" android:color="#090B10" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
